# For host-mode runs (`uv run python -m tactician.batch ...`).
# When running via `docker compose run --rm batch ...`, the compose file
# overrides these with container hostnames (db, s3) and the bundled
# Stockfish binary. You don't need to edit anything for the container path.

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=tactician
MYSQL_PASSWORD=tactician
MYSQL_DATABASE=tactician

# MinIO / S3
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=admin
S3_SECRET_KEY=changeme123
S3_BUCKET_GAMES=games

# Stockfish (host path; container ignores this)
STOCKFISH_PATH=/opt/homebrew/bin/stockfish
STOCKFISH_THREADS=4

# Host directory mounted into the batch container at /mnt/lichess (read-only).
# Only used by `docker compose run --rm batch --file /mnt/lichess/<dump>`.
# LICHESS_DUMP_DIR=/Volumes/bobo-01
