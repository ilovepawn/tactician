# For host-mode runs (`uv run python -m tactician.batch ...`).
# Container path is driven by infra/compose, which injects its own env vars —
# don't touch anything here for that flow.
#
# Values below assume the infra dev stack is up (see ../infra/compose/README.md).

# MySQL — tactician-mysql published on host port 3308 by infra/compose
MYSQL_HOST=localhost
MYSQL_PORT=3308
MYSQL_USER=mwzz6
MYSQL_PASSWORD=1234
MYSQL_DATABASE=tactician

# MinIO / S3 — published on host port 9000 by infra/compose
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=mwzz6
S3_SECRET_KEY=12345678
S3_BUCKET_GAMES=games

# Stockfish (host path; container ignores this)
STOCKFISH_PATH=/opt/homebrew/bin/stockfish
STOCKFISH_THREADS=4

# Host directory mounted into the batch container at /mnt/lichess (read-only).
# Only used by `docker compose run --rm tactician-batch --file /mnt/lichess/<dump>`
# from infra/compose.
# LICHESS_DUMP_DIR=/Volumes/bobo-01
